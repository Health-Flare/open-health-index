---
interface Props {
  title?: string;
  description?: string;
}
const {
  title,
  description = 'Free and open-source health tools for people managing their own health, rated on privacy, platform and ease of setup.',
} = Astro.props;
const fullTitle = title ? `${title} · Open Health Index` : 'Open Health Index';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2C2825" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <div class="brand-group">
          <a class="brand" href="/">Open Health Index</a>
          <a class="family-tag" href="https://healthflare.org" target="_blank" rel="noopener">Part of the Health Flare family</a>
        </div>
        <nav aria-label="Main">
          <a href="/">Browse</a>
          <a href="/about/">About</a>
          <a class="nav-pill" href="https://github.com/Health-Flare/open-health-index">Suggest a tool</a>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div>
          <p>
            Listing a tool is not a medical recommendation. Talk to your care team before changing how you manage your health.
          </p>
          <p>
            Index content is <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a>. Site code is MIT.
            <a href="https://github.com/Health-Flare/open-health-index">Source on GitHub</a>.
          </p>
        </div>
        <nav class="footer-nav" aria-label="Footer links">
          <a href="https://healthflare.org" target="_blank" rel="noopener">Health Flare</a>
          <a href="https://healthflare.org/inner-flare/" target="_blank" rel="noopener">Inner Flare</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* ── Self-hosted fonts, shared with Health Flare & Inner Flare ── */
  @font-face { font-family: 'Fraunces'; src: url('/fonts/Fraunces-Medium.ttf') format('truetype'); font-weight: 500; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Fraunces'; src: url('/fonts/Fraunces-MediumItalic.ttf') format('truetype'); font-weight: 500; font-style: italic; font-display: swap; }
  @font-face { font-family: 'Fraunces'; src: url('/fonts/Fraunces-SemiBold.ttf') format('truetype'); font-weight: 600; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Fraunces'; src: url('/fonts/Fraunces-SemiBoldItalic.ttf') format('truetype'); font-weight: 600; font-style: italic; font-display: swap; }
  @font-face { font-family: 'DM Sans'; src: url('/fonts/DMSans-Regular.ttf') format('truetype'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'DM Sans'; src: url('/fonts/DMSans-Italic.ttf') format('truetype'); font-weight: 400; font-style: italic; font-display: swap; }
  @font-face { font-family: 'DM Sans'; src: url('/fonts/DMSans-Medium.ttf') format('truetype'); font-weight: 500; font-style: normal; font-display: swap; }
  @font-face { font-family: 'DM Sans'; src: url('/fonts/DMSans-MediumItalic.ttf') format('truetype'); font-weight: 500; font-style: italic; font-display: swap; }
  @font-face { font-family: 'DM Sans'; src: url('/fonts/DMSans-SemiBold.ttf') format('truetype'); font-weight: 600; font-style: normal; font-display: swap; }
  @font-face { font-family: 'DM Mono'; src: url('/fonts/DMMono-Regular.ttf') format('truetype'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'DM Mono'; src: url('/fonts/DMMono-Medium.ttf') format('truetype'); font-weight: 500; font-style: normal; font-display: swap; }

  :root {
    --bg: #F4F1EC;
    --surface: #FFFDF9;
    --text: #2C2825;
    --muted: #6B6560;
    --line: rgba(44, 40, 37, 0.15);
    --accent: #F5A623;
    --accent-text: #2C2825;
    --link: #F07560;
    --accent-soft: rgba(245, 166, 35, 0.16);
    --warn-bg: #FBE9E2;
    --warn-text: #7A2E1D;
    --warn-line: #EFB49C;
    --radius: 10px;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --bg: #211D1A;
      --surface: #2C2825;
      --text: #F4F1EC;
      --muted: #B8B0A6;
      --line: rgba(244, 241, 236, 0.15);
      --accent: #F5A623;
      --accent-text: #241B08;
      --link: #F2967F;
      --accent-soft: rgba(245, 166, 35, 0.2);
      --warn-bg: #3A2117;
      --warn-text: #F5C9B8;
      --warn-line: #6B3A26;
      color-scheme: dark;
    }
  }
  :root[data-theme='dark'] {
    --bg: #211D1A;
    --surface: #2C2825;
    --text: #F4F1EC;
    --muted: #B8B0A6;
    --line: rgba(244, 241, 236, 0.15);
    --accent: #F5A623;
    --accent-text: #241B08;
    --link: #F2967F;
    --accent-soft: rgba(245, 166, 35, 0.2);
    --warn-bg: #3A2117;
    --warn-text: #F5C9B8;
    --warn-line: #6B3A26;
    color-scheme: dark;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 17px/1.65 'DM Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
  a { color: var(--link); }
  h1, h2, h3 { font-family: 'Fraunces', Georgia, serif; font-weight: 600; line-height: 1.25; }
  .wrap { max-width: 64rem; margin: 0 auto; padding: 0 16px; }
  .skip { position: absolute; left: -999px; }
  .skip:focus {
    left: 16px; top: 8px; background: var(--surface); color: var(--text);
    padding: 8px 14px; border-radius: 0 0 8px 8px; z-index: 999;
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }

  .site-header {
    position: sticky; top: 0; z-index: 100;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .site-header .wrap { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: center; justify-content: space-between; padding-top: 14px; padding-bottom: 14px; }
  .brand-group { display: flex; align-items: center; gap: 0.85rem; flex-wrap: wrap; }
  .brand {
    font-family: 'Fraunces', Georgia, serif; font-weight: 600; font-size: 1.1rem;
    letter-spacing: -0.01em; text-decoration: none; color: var(--text);
  }
  .family-tag {
    font-size: 0.8rem; color: var(--muted); text-decoration: none;
    padding-left: 0.85rem; border-left: 1px solid var(--line);
  }
  .family-tag:hover { color: var(--text); text-decoration: underline; text-underline-offset: 3px; }
  .site-header nav { display: flex; gap: 18px; flex-wrap: wrap; align-items: center; }
  .site-header nav a:not(.nav-pill) { text-decoration: none; color: var(--text); }
  .site-header nav a:not(.nav-pill):hover { color: var(--link); }

  .nav-pill {
    display: inline-flex; align-items: center;
    background: var(--accent); color: var(--accent-text);
    font-size: 0.875rem; font-weight: 500;
    padding: 0.45rem 1.1rem; border-radius: 100px;
    text-decoration: none !important; border: none;
    transition: opacity 0.15s, box-shadow 0.15s;
  }
  .nav-pill:hover { opacity: 0.9; box-shadow: 0 2px 12px rgba(245, 166, 35, 0.35); }
  .nav-pill:focus-visible { outline: 3px solid var(--text); outline-offset: 3px; }

  main { padding-top: 32px; padding-bottom: 48px; }

  .site-footer { border-top: 1px solid var(--line); color: var(--muted); font-size: 0.9rem; padding: 24px 0 32px; }
  .site-footer .wrap { display: flex; flex-wrap: wrap; gap: 1rem 2rem; align-items: flex-start; justify-content: space-between; }
  .site-footer p { margin: 0 0 6px; }
  .footer-nav { display: flex; gap: 1.25rem; flex-wrap: wrap; }
  .footer-nav a { color: var(--muted); text-decoration: none; }
  .footer-nav a:hover { color: var(--text); text-decoration: underline; text-underline-offset: 3px; }

  .muted { color: var(--muted); }
  .tag {
    display: inline-block; font-family: 'DM Mono', monospace; font-size: 0.78rem; padding: 2px 10px; border-radius: 999px;
    background: var(--accent-soft); color: var(--text); white-space: nowrap;
  }
  .banner {
    background: var(--warn-bg); color: var(--warn-text); border: 1px solid var(--warn-line);
    border-radius: var(--radius); padding: 10px 14px; font-size: 0.92rem;
  }
</style>
