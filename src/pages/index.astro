---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import ToolList from '../components/ToolList.astro';
import FilterBar from '../components/FilterBar.astro';
import { CATEGORIES, type Category } from '../lib/labels';
import { itemList, webSite } from '../lib/structured-data';

const tools = (await getCollection('tools', ({ data }) => data.status !== 'archived')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);

const groups = (Object.keys(CATEGORIES) as Category[])
  .map((key) => ({ key, ...CATEGORIES[key], tools: tools.filter((t) => t.data.category === key) }))
  .filter((g) => g.tools.length > 0);

// Same order the cards appear in.
const jsonLd = [webSite(Astro.site!), itemList(groups.flatMap((g) => g.tools), Astro.site!)];
---
<Base jsonLd={jsonLd}>
  <section class="intro">
    <h1>Health tools you can trust with your data</h1>
    <p>
      Free and open-source apps for tracking symptoms, mood and medications, and for keeping your own records.
      Every listing tells you where your data lives, whether you need an account, and how hard it is to set up.
    </p>
  </section>

  <FilterBar categories={groups.map((g) => ({ key: g.key, label: g.label }))} total={tools.length} />

  <div id="cards-view">
    <nav class="jump" aria-label="Categories">
      {groups.map((g) => <a href={`#${g.key}`} data-jump={g.key}>{g.label}</a>)}
    </nav>

    {
      groups.map((g) => (
        <section class="group" id={g.key} data-group={g.key}>
          <h2>{g.label}</h2>
          <p class="muted">{g.blurb}</p>
          {g.tools.some((t) => t.data.safety_critical) && (
            <p class="banner">
              Some tools here can affect your treatment. They are built by patient communities and are not approved
              medical devices. Talk to your care team before you use them.
            </p>
          )}
          <div class="grid">
            {g.tools.map((t) => (
              <ToolCard tool={t} />
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <ToolList tools={tools} />

  <div id="no-results" class="empty" hidden>
    <p><strong>No tools match these filters.</strong></p>
    <p><button type="button" class="link-button" data-clear>Clear all filters</button></p>
  </div>
</Base>

<script>
  import { initFilters } from '../scripts/filters';
  initFilters();
</script>

<style>
  .intro h1 { font-size: clamp(1.9rem, 4vw, 2.6rem); margin: 0 0 12px; }
  .intro p { max-width: 42rem; font-size: 1.08rem; margin: 0; color: var(--muted); }
  .jump { display: flex; flex-wrap: wrap; gap: 8px; margin: 28px 0 8px; }
  .jump a {
    display: inline-flex; align-items: center;
    background: var(--accent-soft); color: var(--text);
    font-size: 0.82rem; font-weight: 500;
    padding: 0.3rem 0.85rem; border-radius: 100px;
    text-decoration: none; transition: background 0.15s, color 0.15s;
  }
  .jump a:hover { background: var(--accent); color: var(--accent-text); }
  .group { margin-top: 48px; scroll-margin-top: 80px; }
  .group h2 { margin: 0 0 4px; font-size: 1.4rem; }
  .group > p { margin: 0 0 14px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); gap: 14px; }

  .empty { margin-top: 28px; padding: 28px 18px; text-align: center; border: 1px dashed var(--line); border-radius: var(--radius); }
  .empty p { margin: 0 0 6px; }
  .link-button {
    font: inherit; color: var(--link); background: none; border: 0; padding: 0; cursor: pointer;
    text-decoration: underline; text-underline-offset: 3px;
  }
</style>
