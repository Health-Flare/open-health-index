---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { PLATFORMS, SETUP, DATA_LOCATION } from '../lib/labels';
import { getCollection } from 'astro:content';
import { filterAttrs } from '../lib/tool-attrs';
import { placeholderIndex, placeholderStyle } from '../lib/placeholder';

interface Props {
  tool: CollectionEntry<'tools'>;
}
const { tool } = Astro.props;
const d = tool.data;
const shot = d.screenshots[0];
const allIds = (await getCollection('tools')).map((t) => t.id);
const phStyle = shot ? undefined : placeholderStyle(placeholderIndex(tool.id, allIds));
---
<article class="card" {...filterAttrs(tool)}>
  {
    shot ? (
      <Image
        class="shot"
        src={shot.file}
        alt={shot.alt}
        widths={[360, 720]}
        sizes="(max-width: 640px) calc(100vw - 70px), 340px"
        format="webp"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="shot placeholder" style={phStyle} aria-hidden="true" />
    )
  }
  <h3><a href={`/tools/${tool.id}/`}>{d.name}</a></h3>
  <p class="summary">{d.summary}</p>
  <ul class="facts" aria-label="Key facts">
    {d.platforms.map((p) => <li class="tag">{PLATFORMS[p]}</li>)}
    <li class="tag" title={SETUP[d.setup].detail}>Setup: {SETUP[d.setup].label}</li>
    <li class="tag">{DATA_LOCATION[d.privacy.data_location]}</li>
  </ul>
  {d.affiliated && <p class="muted small">Made by the people who run this index.</p>}
</article>

<style>
  .card {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 16px 18px; display: flex; flex-direction: column; gap: 8px;
    transition: box-shadow 0.15s, border-color 0.15s;
  }
  .card:hover { border-color: var(--accent); box-shadow: 0 2px 14px rgba(44, 40, 37, 0.08); }
  h3 { margin: 0; font-size: 1.1rem; }
  /* Phone screenshots are tall. Show the top of the screen in a fixed frame so cards line up. */
  .shot {
    display: block; width: calc(100% + 36px); height: auto; aspect-ratio: 16 / 10;
    margin: -16px -18px 4px; object-fit: cover; object-position: top;
    border-radius: var(--radius) var(--radius) 0 0; border-bottom: 1px solid var(--line);
    background: var(--accent-soft);
  }
  /* No screenshot: a soft gradient unique to the tool (see lib/placeholder.ts).
     Mixed into --surface so it stays gentle in both light and dark themes. */
  .placeholder {
    background: var(--accent-soft);
    background: linear-gradient(
      var(--ph-angle, 135deg),
      color-mix(in oklch, oklch(0.72 0.14 var(--ph-from, 60)) 38%, var(--surface)),
      color-mix(in oklch, oklch(0.72 0.14 var(--ph-to, 100)) 38%, var(--surface))
    );
  }
  h3 a { color: var(--text); text-decoration: none; }
  h3 a:hover { color: var(--link); text-decoration: underline; text-underline-offset: 3px; }
  .summary { margin: 0; }
  .facts { list-style: none; padding: 0; margin: 4px 0 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .small { font-size: 0.85rem; margin: 0; }
</style>
